{
  "name": "amplificatore-controfase",
  "private": true,
  "version": "0.1.0",
  "description": "Amplificatore in controfase in tempo reale (ANC feed-forward) nel browser",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
